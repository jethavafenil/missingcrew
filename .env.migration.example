# Production Supabase Database Connection
# Replace with your actual production credentials from Supabase Dashboard
# Go to: Settings → Database → Connection string

# Direct Connection (recommended for migration)
PROD_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Or Connection Pooling (for transactions)
# PROD_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Local Supabase Database (already configured in .env.local)
LOCAL_DATABASE_URL="postgresql://postgres:[YOUR-LOCAL-PASSWORD]@127.0.0.1:54333/postgres"

# Instructions:
# 1. Copy this file to .env.migration
# 2. Replace [YOUR-PASSWORD], [PROJECT-REF], and [REGION] with your actual values
# 3. Never commit .env.migration to version control!
