# ==============================================================================
# MissingCrew Environment Configuration
# Copy this file to .env.local for Next.js app execution
# Copy this file to .env if running standalone node scripts in /scripts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (MANDATORY TO RUN THE APP)
# Required for database access, user authentication, and page rendering.
# Can be obtained from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection URL (used for migrations and import/export scripts)
# Go to: Supabase Dashboard -> Project Settings -> Database -> Connection string
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
ADMIN_CREATION_SECRET="change-this-to-a-secure-secret"

# ------------------------------------------------------------------------------
# 3. PAYMENTS & SUBSCRIPTIONS (STRIPE / RAZORPAY)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER="stripe" # "stripe" or "razorpay"

# Stripe Settings
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Razorpay Settings (Alternative to Stripe)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP (TRANSACTIONAL EMAILS)
# ------------------------------------------------------------------------------
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_SECURE="false"
EMAIL_USER="your-email@example.com"
EMAIL_PASSWORD="your-email-password"
EMAIL_FROM="MissingCrew <noreply@missingcrew.com>"
CONTACT_EMAIL="contact@missingcrew.com"
SUPPORT_EMAIL="support@missingcrew.com"

# ------------------------------------------------------------------------------
# 5. SMS / OTP (TWILIO)
# ------------------------------------------------------------------------------
# In development, you can enable mock SMS to bypass Twilio without real credentials:
MOCK_SMS="true"
MOCK_SMS_MASTER_CODE="123456"

# For real SMS sending:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ------------------------------------------------------------------------------
# 6. REALTIME / CHAT (PUSHER)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
PUSHER_APP_ID=""
PUSHER_SECRET=""

# ------------------------------------------------------------------------------
# 7. LOCATION & MAPS (LOCATIONIQ)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LOCATIONIQ_API_KEY=""

# ------------------------------------------------------------------------------
# 8. CACHE / RATE LIMITING (REDIS)
# ------------------------------------------------------------------------------
REDIS_URL=""
